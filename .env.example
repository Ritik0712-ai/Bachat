NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Leave empty in development to start a persistent local MongoDB replica set.
MONGODB_URI=
APP_DB=bachat_app
CONTROL_DB=bachat_control
# Generate independent secrets using: openssl rand -hex 32
JWT_SIGNING_KEY=
CSRF_SIGNING_KEY=
RATE_LIMIT_HASH_KEY=
JWT_KEY_ID=v1
# Required in production. Development emails are captured in .data/mail/.
RESEND_API_KEY=
MAIL_FROM=
# Used in published privacy copy; set to your actual contact before launch.
PRIVACY_CONTACT=
